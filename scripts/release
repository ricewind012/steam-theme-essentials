#!/bin/sh -e

log() {
	printf '\033[32;0;1m%s\033[m\n' "$1" >&2
}

die() {
	log "$@"
	exit 1
}

git_branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

git_def_branch() {
	git symbolic-ref --short refs/remotes/origin/HEAD
}

run_semantic_release() {
	GH_TOKEN=$(gh auth token) bunx semantic-release \
		--no-ci \
		--plugins '
			@semantic-release/commit-analyzer,
			@semantic-release/release-notes-generator,
			@semantic-release/github
		' \
		"$@"
}

cleanup() {
	rm -rf "$tmpdir"
}

release() {
	while IFS= read -r line; do case $line in
		*'The next release version'*)
			next=${line##*is }
			break
		;;

		*'There are no relevant changes'*)
			log 'nothing to release!'
			exit 1
		;;
	esac; done <<-EOF
	$(run_semantic_release --dry-run)
	EOF

	if [ -z "$next" ]; then
		is_first_run=1
		next=1.0.0
	fi
	# todo
	commit_msg="chore(release): ${next:=1.0.0}"

	sed -i "s/version = .*/version = \"$next\"/" "$CONFIG_FILE"
	git add "$CONFIG_FILE"
	git commit -m "$commit_msg"
	run_semantic_release
	git push

	log 'released!'
}

open_pr() {
	db_fork_dir="$TMPDIR/plugindb"
	db_repo=SteamClientHomebrew/PluginDatabase
	src_branch=$(git_def_branch)
	src_branch=${src_branch##*/}
	src_url=$(git remote get-url origin)
	src_name=${src_url##*/}
	src_name=${src_name%.git}
	gh repo fork "https://github.com/$db_repo" --clone -- "$db_fork_dir"
	cd "$db_fork_dir"

	db_branch=$(git_def_branch)
	db_branch=${db_branch##*/}
	# TODO: vibed, change the changelog also, and the ifs below are uselss maybe
	existing_pr=$(gh pr list \
		--repo "$db_repo" \
		--state open \
		--base "$db_branch" \
		--json headRefName,headRepository \
		--jq "[.[] | select(.headRefName | startswith(\"$src_name/v\"))] | if length > 1 then error(\"multiple open PRs found for $src_name\") elif length == 1 then .[0] | [.headRepository.nameWithOwner // \"null\", .headRefName] | @tsv else empty end")
	if [ -n "$existing_pr" ]; then
		IFS="$(printf '\t')" read -r pr_repo pr_branch <<-EOF
		$existing_pr
		EOF
		if [ "$pr_repo" = null ]; then
			log 'the existing PR fork is unavailable'
			exit 1
		fi
		git remote add pr-fork "https://github.com/$pr_repo.git"
		git fetch pr-fork "$pr_branch:refs/remotes/pr-fork/$pr_branch"
		git switch --track --create "$pr_branch" "pr-fork/$pr_branch"
		push_remote=pr-fork
	else
		pr_branch="$src_name/v$next"
		git switch --create "$pr_branch"
		push_remote=origin
	fi

	submodule_path=plugins/$src_name
	if git config -f .gitmodules --get "submodule.plugins/$src_name" >/dev/null; then
		git submodule update --init "$submodule_path"
		git -C "$submodule_path" fetch origin "$src_branch"
	else
		git submodule add -b "$src_branch" "$src_url" "$submodule_path"
	fi

	target_sha=$(git -C "$submodule_path" rev-parse "$tag")
	pr_branch="$src_name/v$next"
	git switch --create "$pr_branch"
	git -C "$submodule_path" checkout --detach "$target_sha"
	git add "$submodule_path"

	if [ "$is_first_run" ]; then
		pr_template=pull_request_template
		pr_title="Add $plugin_name"
	else
		pr_template=PULL_REQUEST_TEMPLATE/PLUGIN-UPDATE
		pr_title="Update $plugin_name to $next"
	fi

	while IFS=' =' read -r k v; do
		case $k in name)
			k=${k#\"}
			plugin_name=${k%\"}
			break
		esac
	done < "$CONFIG_FILE"
	while IFS= read -r line; do
		case $line in
			''|'# '*) ;;
			*) changelog="$changelog$newline$line" ;;
		esac
	done <<-EOF
	$(gh release view "v$next" --json body --jq '.body')
	EOF
	while IFS= read -r line; do
		case $line in
			'# REPLACE_WITH_PLUGIN_NAME') pr_body="# $plugin_name$newline$line" ;;
			REPLACE_WITH_SUMMARY|REPLACE_WITH_UPDATE_SUMMARY) pr_body="$changelog$newline$line" ;;
			*) pr_body="$pr_body$newline$line" ;;
		esac
	done <<-EOF
	$(curl "https://raw.githubusercontent.com/$db_repo/refs/heads/$db_branch/.github/$pr_template")
	EOF

	git commit -m "$pr_title"
	git push -u "$push_remote" "$pr_branch"
	if [ -n "$existing_pr" ]; then
		log 'existing PR updated!'
	else
		gh pr create \
			--web \
			--repo "https://github.com/$db_repo" \
			--base "$db_branch" \
			--head "$pr_branch" \
			--title "$pr_title" \
			--body "$pr_body"
	fi
}

main() {
	: "${TMPDIR:=/tmp}"
	CONFIG_FILE=millennium.toml

	tmpdir=$(mktemp -d "$TMPDIR/submodule-pr.XXXXXX")
	trap cleanup 0 HUP INT TERM

	release
	open_pr
}

main "$@"
